# Copy to .env and adjust. Never commit the real .env.

# "production" on Render. It turns on secure cookies and the production checks below
# (JWT_ACCESS_SECRET length, CLIENT_IP_SIGNING_SECRET). Leave unset locally.
# NODE_ENV=production

# Port the API listens on (frontend Next.js uses 3000)
PORT=5000

# Allowed CORS origin
FRONTEND_URL=https://secret-santa-project-mu.vercel.app

# Extra browser origins allowed to open the realtime socket, comma-separated
# (FRONTEND_URL is always allowed). Local development next to production: http://localhost:3000
CORS_ORIGINS=

# PostgreSQL (Supabase → Connect → Session pooler). Tables: run db/migrations/*.sql
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# false for local PostgreSQL (no TLS support). Supabase requires TLS → set true
DATABASE_SSL=false
# Optional: path to Supabase CA certificate for full TLS verification
# DATABASE_SSL_CA=./certs/supabase-ca.crt

# Signs access tokens. Long random string, different per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me

# Sign-in limits. The Next.js proxy on Vercel signs the visitor's IP with this secret;
# the API checks the signature. Set the SAME value on Render and on Vercel (server-side
# only there — never NEXT_PUBLIC_). It never travels between them, only signatures do.
# Format: 32+ random bytes, base64url (43+ chars) or hex (64+ chars). Generate straight
# into the clipboard so it never shows in a terminal or a log:
#   node -e "process.stdout.write(require('crypto').randomBytes(48).toString('base64url'))" | clip
# Production: required — a missing, short or weak value stops the start-up (the failed
# deploy never replaces the running one). Locally optional: unset = every sign-in shares
# the "unverified" limits. Check after a deploy: https://<frontend>/api/auth/client-ip-check
# must answer {"signature":"valid"} (see db/README.md, section 007).
CLIENT_IP_SIGNING_SECRET=

# Requests per window, counted in PostgreSQL (db/migrations/007) across all instances.
# Per signed IP, and "unverified" = everything without a valid signature, together.
# Defaults shown; leave unset to use them.
# AUTH_LOGIN_LIMIT=30
# AUTH_UNVERIFIED_LOGIN_LIMIT=60
# AUTH_LOGIN_WINDOW_SECONDS=900
# AUTH_REGISTER_LIMIT=10
# AUTH_UNVERIFIED_REGISTER_LIMIT=20
# AUTH_REGISTER_WINDOW_SECONDS=3600

# Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID,
# type "Web application"). Leave id/secret empty to disable. Never commit real values.
# The callback goes through the Next.js /api rewrite so auth cookies stay first-party:
# it is the FRONTEND's address (the state cookie set on /api/auth/google lives there),
# never the Render host. Register exactly this URL as an "Authorized redirect URI".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://secret-santa-project-mu.vercel.app/api/auth/google/callback

# AI gift assistant. Keys are server-side only: never put them in the frontend or behind
# NEXT_PUBLIC_, never commit real values. Without the active provider's key the app still
# starts and the assistant answers "unavailable".
# Which model answers: gemini (default) or anthropic
AI_PROVIDER=gemini
# Google Gemini: Google AI Studio → Get API key
GEMINI_API_KEY=
# Anthropic Claude (alternative, AI_PROVIDER=anthropic): Console → API Keys
ANTHROPIC_API_KEY=
